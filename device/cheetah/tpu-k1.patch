- * Write the payload to kci_payload (up to one page), then the code to
+ * Write the payload to kci_payload (up to EDGETPU_KCI_PAYLOAD_MAX), then the code to
  * kci_send; the return value is the firmware's response code (or -errno),
  * also logged.
  */
-static u8 edgetpu_kci_payload[PAGE_SIZE];
+#define EDGETPU_KCI_PAYLOAD_MAX (16 * PAGE_SIZE)
+static u8 edgetpu_kci_payload[EDGETPU_KCI_PAYLOAD_MAX];
 static size_t edgetpu_kci_payload_len;
 
 /* The last command's DMA buffer, so userspace can read what the firmware wrote. */
 static u8 edgetpu_kci_result[PAGE_SIZE];
 static size_t edgetpu_kci_result_len;
 
+/* The last send's return code, so a size sweep need not read dmesg each time. */
+static int edgetpu_kci_last_result;
+static int edgetpu_kci_last_get(void *data, u64 *val)
+{
+	*val = (u64)(s64)edgetpu_kci_last_result;
+	return 0;
+}
+DEFINE_DEBUGFS_ATTRIBUTE(fops_kci_last, edgetpu_kci_last_get, NULL, "%lld\n");
 
 /* Send with the kci_scratch allocation as the command's DMA descriptor. */
 static bool edgetpu_kci_dma_scratch;
@@ -1147,6 +1156,7 @@
 	struct edgetpu_coherent_mem page = {0};
 	struct edgetpu_coherent_mem *mem = &page;
 	size_t len = edgetpu_kci_payload_len;
+	size_t alloc_size;
 	bool own = true;
