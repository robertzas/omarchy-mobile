CONFIG_SAMSUNG_IOMMU_GROUP=m
CONFIG_EDGETPU_FRAMEWORK=m
CONFIG_JANEIRO=m
CONFIG_GOOGLE_GSA=m
CONFIG_GOOGLE_GSA_TRUSTY=y
CONFIG_TRUSTY=m
CONFIG_TRUSTY_IRQ=y
