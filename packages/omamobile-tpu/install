#!/bin/bash
# SPDX-License-Identifier: MIT
set -euo pipefail
pkgdir=${1:?usage: install DESTDIR}
# makepkg runs package() from $srcdir, so anchor on the package directory.
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
install -Dm755 bin/omamobile-tpu "$pkgdir/usr/bin/omamobile-tpu"
install -Dm644 units/omamobile-tpu-status.service "$pkgdir/usr/lib/systemd/system/omamobile-tpu-status.service"
