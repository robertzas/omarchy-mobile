#!/bin/sh
# SPDX-License-Identifier: MIT
# omamobile-tpu: report the Edge TPU's bring-up state. Read-only apart from one
# KCI 11 query; the product path grows here once firmware setup exists (G0 in
# device/cheetah/TPU-PLAN.md).
set -u
D=${TPU_DEBUGFS:-/sys/kernel/debug/edgetpu/janeiro}
json=
gate_only=0
mode=report
for a in "$@"; do
	[ "$a" = --json ] && json=--json
	[ "$a" = --gate ] && gate_only=1
	[ "$a" = selftest ] && mode=selftest
done
info=unknown
if [ -w "$D/kci_send" ]; then
	printf '11\n' >"$D/kci_send" 2>/dev/null
	sleep 1
	info=$(od -An -tx1 -N16 "$D/kci_result" 2>/dev/null | tr -d '\n ')
	[ -n "$info" ] || info=unknown
fi
gate=$(dmesg | grep -c 'Setup is not done yet')
k1=$(dmesg | grep -c 'K1: power-up')
# K1: one power-up per boot. An all-zero fw_info means it is already spent.
spent=false
case "$info" in 0000000000000000*) spent=true ;; esac
dev=$([ -e /dev/janeiro ] && echo true || echo false)
# The self-test: gate, transport, and the wall by name. Exit 0 only when a model
# can run (the setup wall is gone), 3 while the wall stands, 1 when the transport
# is broken. It is the one check a product caller can run without knowing KCI.
kci() {
	printf '%s\n' "$1" >"$D/kci_send" 2>/dev/null || { echo "-EIO"; return; }
	cat "$D/kci_last" 2>/dev/null || echo "-EIO"
}
selftest() {
	case "$info" in
	unknown) echo "selftest FAIL: the door does not answer"; return 1 ;;
	0000000000000000*) echo "selftest FAIL: dark or spent boot ($info)"; return 1 ;;
	esac
	r11=$(kci 11); r12=$(kci 12); r21=$(kci 21)
	echo "selftest transport: KCI 11 -> $r11, 12 -> $r12, 21 -> $r21"
	# KCI 11 is the transport proof: it answers 0 with the firmware's build id.
	# 12 and 21 are usage queries the A17 firmware refuses through this door
	# (3), so they are reported, not required; a send that never reached the
	# firmware answers -EIO instead and is a transport failure.
	case "$r11" in
	0) ;;
	-EIO) echo "selftest FAIL: the door did not take KCI 11"; return 1 ;;
	*) echo "selftest FAIL: KCI 11 answered $r11"; return 1 ;;
	esac
	case "$r12$r21" in
	*-EIO*) echo "selftest FAIL: a door send did not reach the firmware"; return 1 ;;
	esac
	# A setup proof exists only after an inference has actually run on this
	# phone, and the plan's G0 writes this marker. The absence of the wall line
	# proves nothing: the firmware logs it only when a VII command is attempted,
	# and this self-test sends none.
	if [ -e /var/lib/omamobile/tpu-setup-proven ]; then
		echo "selftest: transport ok, and a successful inference is on record"
		return 0
	fi
	echo "selftest: transport ok; setup is not proven (no inference on record)"
	echo "selftest: no inference is claimed until G0 (firmware setup)"
	return 3
}
if [ "$mode" = selftest ]; then
	selftest
	exit $?
fi
# The boot gate: a boot whose power-up is spent cannot do TPU work, and every
# caller that needs the TPU says so here instead of discovering it mid-run.
if [ "$gate_only" = 1 ]; then
	if [ "$spent" = true ] || [ "$info" = unknown ]; then
		echo "gate: this boot cannot do TPU work (fw_info=$info, spent=$spent)" >&2
		exit 3
	fi
	echo "gate: ok (fw_info=$info)"
	exit 0
fi
if [ "$json" = --json ]; then
	printf '{"kernel":"%s","device":%s,"fw_info":"%s","gate_lines":%s,"assertions":%s,"crashes":%s,"k1_refusals":%s,"spent":%s}\n' \
		"$(uname -r)" "$dev" "$info" "$gate" \
		"$(dmesg | grep -c 'ASSERTION FAILED')" \
		"$(dmesg | grep -c 'firmware unrecoverable crash')" "$k1" "$spent"
	exit 0
fi
printf 'kernel    %s\ndevice    %s\nfw_info   %s\nwall      %s\nk1        %s refusal(s) this boot\nspent     %s\n' \
	"$(uname -r)" "$dev" "$info" \
	"$([ "$gate" -gt 0 ] && echo 'setup gated' || echo 'gate not logged this boot')" "$k1" "$spent"
if [ "$spent" = true ]; then
	echo "note      the boot's power-up is spent; reboot to use the TPU"
fi
exit 0
