#!/bin/bash
# SPDX-License-Identifier: MIT
# Static checks: the scripts parse and the unit carries the fields systemd needs.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
fail() { echo "FAIL: $*" >&2; exit 1; }
bash -n install || fail "syntax: install"
sh -n bin/omamobile-tpu || fail "syntax: omamobile-tpu"
grep -q '^ExecStart=/usr/bin/omamobile-tpu status --json$' units/omamobile-tpu-status.service \
  || fail "the unit runs the reporter"
grep -q '^\[Service\]$' units/omamobile-tpu-status.service || fail "the unit has a [Service]"
for f in bin/omamobile-tpu install; do [ -x "$f" ] || fail "not executable: $f"; done
grep -q 'for a in "\$@"' bin/omamobile-tpu || fail "the reporter finds --json among its arguments"
grep -q '^WantedBy=multi-user.target$' units/omamobile-tpu-status.service || fail "the unit is enable-able"
grep -q '^ExecStartPre=/usr/bin/sleep 10$' units/omamobile-tpu-status.service || fail "the unit waits for the module"
grep -q '"k1_refusals"' bin/omamobile-tpu || fail "the report carries the K1 count"
grep -q '"spent"' bin/omamobile-tpu || fail "the report names a spent boot"
grep -q '^ExecStart=/usr/bin/omamobile-tpu --gate$' units/omamobile-tpu-gate.service \
  || fail "the gate unit runs the gate"
# The gate must fail on a spent boot and pass on a live one, without the phone:
# a fake door with an all-zero fw_info is a spent boot.
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
: >"$tmp/kci_send"; : >"$tmp/kci_result"
TPU_DEBUGFS=$tmp PATH=$PWD/bin:$PATH omamobile-tpu --gate >/dev/null 2>&1 \
  && fail "the gate passed on an all-zero fw_info"
printf '\361\111\324\151\000\000\000\000\003\000\000\000\126\110\141\065' >"$tmp/kci_result"
TPU_DEBUGFS=$tmp PATH=$PWD/bin:$PATH omamobile-tpu --gate >/dev/null 2>&1 \
  || fail "the gate refused a live fw_info"
echo "ok - omamobile-tpu"
