#!/bin/sh
# SPDX-License-Identifier: MIT
# Bring up the vendor Tachyon compute stack on a Linux userspace, then run the
# reference delegate. Run on the phone as root; it only touches /dev/binderfs,
# the extracted vendor chroot under $R, and /tmp.
#
# Why: the TPU firmware refuses every VII command until its one-time setup
# command has run, and on stock Android that command comes from the vendor
# service. That service is binder-only, so this mounts binderfs and runs
# servicemanager plus LD_PRELOAD shims that stand in for logd and SELinux.
# See device/cheetah/TPU-PLAN.md U27/U28/U34.
#
# The Edge TPU binaries live in /vendor, and vendor libbinder talks to
# /dev/vndbinder (their own log says so), so the whole chain runs on the vendor
# binder domain with /vendor/lib64 first.
set -u

R=/usr/lib/omamobile-vendor/edgetpu/root
LOG=/tmp/tpu-tachyon.log
: >"$LOG"
# A libbinder wait loop can print gigabytes in seconds; cap the file so a
# spin cannot fill userdata.
ulimit -f 51200 2>/dev/null || true

# CORES=1 makes a crashing service leave a core. The kernel's core_pattern is
# systemd's here, so point it at a file in the chroot's root for this run and
# put the old value back on exit. An attach has already killed the Tachyon
# service once (U62); a core answers "where did it die" without one.
if [ "${CORES:-0}" = "1" ]; then
	ulimit -c unlimited 2>/dev/null || true
	CORE_OLD=$(cat /proc/sys/kernel/core_pattern)
	echo "core_pattern: $CORE_OLD -> /core.%e.%p" >>"$LOG"
	echo '/core.%e.%p' >/proc/sys/kernel/core_pattern
	# No trap: the services outlive this script, and the crash we want may
	# come later. Save the old value so it can be put back by hand.
	echo "$CORE_OLD" >/tmp/tpu-core-pattern.old
fi

log() {
	echo "=== $*" >>"$LOG"
}

run() {
	echo "+ $*" >>"$LOG"
	"$@" >>"$LOG" 2>&1
}

log "kernel $(uname -r)"
# The module must load exactly once per boot: a second load (or a load racing
# udev's autoload at ~11 s) oopses in edgetpu_mmu_attach. Give udev 20 s to
# bring it up, then insmod only if the device still is not there.
i=0
while [ ! -e /dev/janeiro ] && [ $i -lt 40 ]; do
	sleep 0.5
	i=$((i + 1))
done
if [ -e /dev/janeiro ]; then
	log "janeiro up after ~$((i / 2))s (autoload)"
elif lsmod | grep -q '^janeiro'; then
	# Loaded but no device: the probe crashed. A second insmod would oops
	# again, so stop and let a cold boot reset the TPU.
	log "janeiro loaded but /dev/janeiro missing (probe failed), stopping"
	dmesg | tail -20 >>"$LOG"
	tail -n 30 "$LOG"
	exit 1
else
	log "janeiro absent after 20s, loading once"
	run insmod "$(modinfo -n janeiro)"
	i=0
	while [ ! -e /dev/janeiro ] && [ $i -lt 20 ]; do
		sleep 0.5
		i=$((i + 1))
	done
fi
if [ ! -e /dev/janeiro ]; then
	log "janeiro did not come up, stopping"
	tail -n 30 "$LOG"
	exit 1
fi
ln -sfn janeiro /dev/edgetpu
# The Tachyon core opens /dev/edgetpu-soc for its VII kernel interface
# (ioctl_kernel_if.cc:123). Without the node the virtual device goes to
# IN_ERROR with "Virtual device failure" before any ioctl reaches janeiro.
ln -sfn janeiro /dev/edgetpu-soc
# The device must be root-only: as an app uid, EACCES on /dev/edgetpu is what
# makes the vendor util library take its Tachyon client path (root always goes
# direct). udev creates it 0666, so without this the delegate silently opens
# the driver itself, no Tachyon session exists, and the firmware's setup
# command is never sent. The app service itself runs as uid 1000 (stock's
# system) and opens /dev/edgetpu to own the session, so the device ships 0660
# system: group 1000 opens it, an app uid 10000 still gets EACCES.
chown root:1000 /dev/janeiro 2>/dev/null
chmod 660 /dev/janeiro
run lsmod

log "binderfs"
mkdir -p /dev/binderfs /dev/dma_heap
mountpoint -q /dev/binderfs || run mount -t binder binder /dev/binderfs
for n in binder hwbinder vndbinder; do ln -sfn /dev/binderfs/$n /dev/$n; done
# RUN_UID runs the delegate as an app uid, which is the only way the vendor
# util library takes its Tachyon client path (root always goes direct). The
# binder nodes therefore have to be reachable from that uid. /dev/edgetpu must
# stay root-only: EACCES on it is what selects the client path.
chmod 666 /dev/binderfs/binder /dev/binderfs/hwbinder /dev/binderfs/vndbinder 2>/dev/null
[ -e /dev/dma_heap/system ] || mknod /dev/dma_heap/system c 249 0
ls -l /dev/binderfs /dev/dma_heap >>"$LOG" 2>&1

log "chroot mounts"
mkdir -p "$R/dev/dma_heap" "$R/dev/binderfs" "$R/proc" "$R/sys" "$R/vendor/etc" "$R/root"
# A full rbind of /dev has come back ENOSPC here ("move_mount() failed: No
# space left on device"), and then the chroot has no /dev/edgetpu: the app
# service cannot open the device it is supposed to own, so the delegate gets
# EACCES from it (status 13) even with every service up. Mount the nodes the
# services need one at a time, and log what the chroot really sees.
mountpoint -q "$R/dev" || run mount --rbind /dev "$R/dev"
if [ -e /dev/janeiro ] && [ ! -e "$R/dev/janeiro" ]; then
	: >"$R/dev/janeiro"
	run mount --bind /dev/janeiro "$R/dev/janeiro"
fi
ln -sfn janeiro "$R/dev/edgetpu"
ln -sfn janeiro "$R/dev/edgetpu-soc"
[ -e "$R/dev/dma_heap/system" ] || mknod "$R/dev/dma_heap/system" c 249 0
for n in binder hwbinder vndbinder; do
	if [ -e "/dev/binderfs/$n" ] && [ ! -e "$R/dev/binderfs/$n" ]; then
		: >"$R/dev/binderfs/$n"
		run mount --bind "/dev/binderfs/$n" "$R/dev/binderfs/$n"
	fi
	ln -sfn "binderfs/$n" "$R/dev/$n"
done
mountpoint -q "$R/proc" || run mount -t proc proc "$R/proc"
mountpoint -q "$R/sys" || run mount --rbind /sys "$R/sys"
log "chroot dev"
ls -l "$R/dev/janeiro" "$R/dev/edgetpu" "$R/dev/edgetpu-soc" "$R/dev/dma_heap/system" >>"$LOG" 2>&1
# The services need these before they start, not just before the delegate:
# the vendor service's cache cleanup runs at startup and its cache path is
# /data/vendor/edgetpu/cache/, and the Tachyon service takes tensors from
# /dev/dma_heap/system. Both were being created after the vendor service had
# already aborted in cache cleanup.
chmod 666 /dev/dma_heap/system 2>/dev/null
mkdir -p "$R/data/vendor/hal_neuralnetworks_darwinn" "$R/data/vendor/edgetpu/cache" "$R/data/edgetpu"
chmod 777 "$R/data/vendor/hal_neuralnetworks_darwinn" "$R/data/vendor/edgetpu" "$R/data/vendor/edgetpu/cache" "$R/data/edgetpu"
cp /root/model.tflite "$R/vendor/etc/model.tflite" 2>/dev/null
cp /root/liblogstderr.so "$R/system/lib64/liblogstderr.so" 2>/dev/null
cp /root/libselinux-shim.so "$R/system/lib64/libselinuxshim.so" 2>/dev/null
cp /root/libpropsshim.so "$R/system/lib64/libpropsshim.so" 2>/dev/null
cp /root/libstackchkshim.so "$R/system/lib64/libstackchkshim.so" 2>/dev/null
cp /root/dlopenprobe.so "$R/system/lib64/dlopenprobe.so" 2>/dev/null
cp /root/liblazysvc.so "$R/system/lib64/liblazysvc.so" 2>/dev/null
cp /root/libnosid.so "$R/system/lib64/libnosid.so" 2>/dev/null
cp /root/libabortshim.so "$R/system/lib64/libabortshim.so" 2>/dev/null
# Names a SIGSEGV's fault address and backtrace; the Tachyon core dies in
# MainTpuActor without a log line (TPU-PLAN U122).
cp /root/libsegvshim.so "$R/system/lib64/libsegvshim.so" 2>/dev/null
# TPU_VLOG raises the core's vlog level before it parses any command, so the
# log says why a register is refused (android-vlog-shim.c).
cp /root/libvlogshim.so "$R/system/lib64/libvlogshim.so" 2>/dev/null
cp /root/libpermissionshim.so "$R/system/lib64/libpermissionshim.so" 2>/dev/null

# Vendor first: that is what makes libbinder pick /dev/vndbinder, the domain
# the Edge TPU services and the delegate register and look up on.
export LD_LIBRARY_PATH=/apex/com.android.tethering/lib64:/system_ext/lib64:/vendor/lib64:/system/lib64:/apex/com.android.runtime/lib64/bionic
USPEC=
[ -n "${RUN_UID:-}" ] && USPEC="--userspec=$RUN_UID:$RUN_UID"
# The delegate is the one caller that must run as an app uid: EACCES on
# /dev/edgetpu is what makes the util library ask the app service for a
# device instead of opening the driver itself. The services keep $USPEC
# (root by default), because a service that cannot open /dev/janeiro cannot
# serve a device to anyone, which is what made "RUN_UID=10000" report
# status 13. DELEGATE_UID sets the delegate alone.
DUID=${DELEGATE_UID:-10000}
DUSPEC="--userspec=$DUID:$DUID"
# servicemanager links libbinder (C++), not libbinder_ndk, so it must not get
# the lazy-registration shim: that shim's AServiceManager_addService has no
# provider there and the linker refuses to start the binary.
export LD_PRELOAD="/system/lib64/liblogstderr.so /system/lib64/libselinuxshim.so /system/lib64/libpropsshim.so"

log "servicemanager (vendor binder domain)"
pkill -x servicemanager 2>/dev/null
sleep 0.5
setsid chroot "$R" /system/bin/servicemanager /dev/vndbinder >>"$LOG" 2>&1 </dev/null &
sleep 2
echo "servicemanager pid: $(pgrep -x servicemanager)" >>"$LOG"

# libnosid first: without it every transaction to a node published by
# libbinder fails in the kernel (no LSM provides secid_to_secctx here, so
# FLAT_BINDER_FLAG_TXN_SECURITY_CTX cannot be honoured).
# Then the lazy-registration shim: the stock servicemanager answers
# registerLazyService with ENOTSUP, and AidlLazyServiceRegistrar aborts the
# service on any non-OK status.
SVC_PRELOAD="/system/lib64/libsegvshim.so /system/lib64/libnosid.so /system/lib64/liblazysvc.so /system/lib64/libpermissionshim.so /system/lib64/libabortshim.so $LD_PRELOAD"
[ -n "${TPU_VLOG:-}" ] && SVC_PRELOAD="/system/lib64/libvlogshim.so $SVC_PRELOAD"

# The Tachyon core connects to android.hardware.power.IPower/default while it
# creates a session and caches a failed lookup, so the Power HAL has to be up
# first (TPU-PLAN U56). Without it the core logs "Unable to connect to Power
# HAL", the session stays in CREATED, and no command is ever dispatched: the
# client's receiveResponse answers "no response" forever (U64).
log "power hal"
pkill -f 'android.hardware.power-service' 2>/dev/null
sleep 0.5
POWER_HAL=$(ls "$R"/vendor/bin/hw/android.hardware.power-service* 2>/dev/null | head -1)
if [ -n "$POWER_HAL" ]; then
	# $USPEC for the same reason as the Darwinn HAL below: RUN_UID must
	# reach every service the runner starts, or a run "as the app uid"
	# still starts this one as root.
	setsid env LD_PRELOAD="$SVC_PRELOAD" chroot $USPEC "$R" "${POWER_HAL#"$R"}" >>"$LOG" 2>&1 </dev/null &
	sleep 3
	echo "power hal: ${POWER_HAL##*/} pid $(pgrep -f 'android.hardware.power-service' | head -1)" >>"$LOG"
else
	echo "power hal: no binary in the chroot" >>"$LOG"
fi

# Stock's order: the vendor service owns /dev/edgetpu, the tachyon service
# fronts it, and Darwinn's NNAPI HAL publishes IEdgeTpuAppService for clients.
log "vendor edgetpu service"
pkill -x vendor.google.e 2>/dev/null
sleep 0.5
setsid env LD_PRELOAD="$SVC_PRELOAD" chroot "$R" /vendor/bin/hw/vendor.google.edgetpu_vendor_service@1.0-service >>"$LOG" 2>&1 </dev/null &
sleep 3
echo "vendor pid: $(pgrep -f vendor.google.edgetpu_vendor | head -1)" >>"$LOG"

# The HAL enumerates with a detachable group and no wakelock, so the driver
# powers the TPU down at finalize; the delegate's next group then makes the
# second power-up of the boot, which wedges the PSM (U54:
# PSM0_STATUS=0x5644c13, LPM_CONTROL=0x1240). Take the driver wakelock first:
# the HAL's probe and every later group then reuse the one power-up.
if ! pgrep -x tpu-hold >/dev/null; then
	log "tpu hold (first power-up, keeps it on)"
	setsid /root/tpu-hold >>"$LOG" 2>&1 </dev/null &
	sleep 2
fi

log "tachyon service"
pkill -x com.google.edge 2>/dev/null
sleep 0.5
# Stock's init rc runs it as user/group system with rlimit rtprio 99 and
# SYS_NICE/IPC_LOCK. As root the core's GXP main actor fails to set up (its
# scoped eventfd comes back empty) and the service dies at startup (U65), so
# run it as system, like stock.
setsid env LD_PRELOAD="$SVC_PRELOAD" chroot --userspec=1000:1000 "$R" /vendor/bin/hw/com.google.edgetpu.tachyon-service >>"$LOG" 2>&1 </dev/null &
sleep 3
echo "tachyon pid: $(pgrep -x com.google.edge)" >>"$LOG"

log "edgetpu app service"
pkill -f 'vendor.google.edgetpu_app_service' 2>/dev/null
sleep 0.5
# The app service is the missing publisher of
# com.google.edgetpu.IEdgeTpuAppService/default: the HAL and the delegate both
# ask it for the device fd before they create a group. On stock it lives in
# system_ext and runs as the system user; its init rc declares the AIDL
# interface. It is not in the vendor image, so earlier runs had no host.
setsid env LD_PRELOAD="$SVC_PRELOAD" chroot --userspec=1000:1000 "$R" /system_ext/bin/hw/vendor.google.edgetpu_app_service@1.0-service >>"$LOG" 2>&1 </dev/null &
sleep 3
echo "app service pid: $(pgrep -f vendor.google.edgetpu_app_service | head -1)" >>"$LOG"

log "darwinn nnapi hal"
# The HAL is needed only by the delegate path (it publishes the NNAPI driver the
# delegate uses). For a client-only run it is worse than useless: it builds a
# group as the app uid and aborts before finalizing it, and that leaked group
# makes the next edgetpu_mmu_alloc_domain fail with an oops (U65). Skip it when
# no delegate will run.
if [ "${NO_DELEGATE:-0}" = "1" ]; then
	echo "hal skipped (NO_DELEGATE=1)" >>"$LOG"
else
# comm is 15 chars, so -x android.hardwar also matches the Power HAL
# (android.hardware.power-service...): match the full command line instead.
pkill -f 'android.hardware.neuralnetworks@service-darwinn-aidl' 2>/dev/null
sleep 0.5
# The HAL runs as the app uid, not root: as root the util library opens
# /dev/edgetpu itself and builds its own group, where the setup payload has no
# mapping. A non-root uid gets EACCES and takes the Tachyon client path through
# the service that already owns the device.
rm -f "$R/data/vendor/hal_neuralnetworks_darwinn/NnapiHalSocketHalProcess"
# HAL_PRELOAD is for the HAL alone: android-addservice-shim.c answers its
# NNAPI registration with OK, which servicemanager refuses a uid-10000 caller.
# The services that must really be visible never get it.
setsid env LD_PRELOAD="${HAL_PRELOAD:-} $SVC_PRELOAD" chroot $USPEC "$R" /vendor/bin/hw/android.hardware.neuralnetworks@service-darwinn-aidl >>"$LOG" 2>&1 </dev/null &
sleep 4
echo "hal pid: $(pgrep -x android.hardwar)" >>"$LOG"
# HAL_ONLY=1 stops here: the point is the HAL's own firmware setup, and the
# delegate would take the same group (U55) or crash the servicemanager (U61).
if [ "${HAL_ONLY:-0}" = "1" ]; then
echo "hal only: leaving the chain up" >>"$LOG"
log "dmesg"
dmesg | grep -iE 'edgetpu|janeiro|tachyon' | tail -20 >>"$LOG"
log "done"
tail -n 40 "$LOG"
exit 0
fi
fi

log "delegate"
# NO_DELEGATE=1 leaves the chain up for a client run: the delegate's teardown
# takes the vendor servicemanager down with it (U61), and then no later client
# can find the Tachyon service.
if [ "${NO_DELEGATE:-0}" = "1" ]; then
	echo "delegate skipped (NO_DELEGATE=1)" >>"$LOG"
	log "dmesg"
	dmesg | grep -iE 'edgetpu|janeiro|tachyon' | tail -20 >>"$LOG"
	log "done"
	tail -n 40 "$LOG"
	exit 0
fi
DELEGATE_PRELOAD="/system/lib64/libnosid.so /system/lib64/libnometrics.so /system/lib64/libstackchkshim.so /system/lib64/liblogstderr.so /system/lib64/libabortshim.so /system/lib64/libselinuxshim.so /system/lib64/libpropsshim.so"
# PROBE=1 loads the vendor client libraries first, to tell a dlopen failure
# apart from a choice the delegate makes.
[ "${PROBE:-0}" = "1" ] && DELEGATE_PRELOAD="/system/lib64/dlopenprobe.so $DELEGATE_PRELOAD"
if [ "${GDB:-0}" = "1" ]; then
	# Stop at the abort that happens right after OPEN_DEVICE and print the
	# frames; the delegate is unstripped, so the smashed function is named.
	gdb -batch -q \
		-ex "set sysroot $R" \
		-ex "set follow-exec-mode same" \
		-ex "set environment LD_LIBRARY_PATH=$LD_LIBRARY_PATH" \
		-ex "set environment LD_PRELOAD=$DELEGATE_PRELOAD" \
		-ex "file /usr/bin/chroot" \
		-ex "set args $R /vendor/bin/edgetpu-run /vendor/etc/model.tflite" \
		-ex run -ex "bt 25" >>"$LOG" 2>&1
	echo "gdb rc: $?" >>"$LOG"
elif [ "${BT:-0}" = "1" ]; then
	LD_PRELOAD="$DELEGATE_PRELOAD" chroot $DUSPEC "$R" /vendor/bin/edgetpu-run /vendor/etc/model.tflite >>"$LOG" 2>&1 &
	dpid=$!
	sleep 6
	log "backtrace of $dpid"
	gdb -batch -q -p "$dpid" -ex "set sysroot $R" -ex "thread apply all bt 15" >>"$LOG" 2>&1
	echo "--- wchan: $(cat /proc/$dpid/wchan 2>/dev/null) syscall: $(cat /proc/$dpid/syscall 2>/dev/null)" >>"$LOG"
	kill "$dpid" 2>/dev/null
	wait "$dpid" 2>/dev/null
else
	LD_PRELOAD="$DELEGATE_PRELOAD" timeout 25 \
		chroot $DUSPEC "$R" /vendor/bin/edgetpu-run /vendor/etc/model.tflite >>"$LOG" 2>&1
	echo "delegate rc: $?" >>"$LOG"
fi

log "dmesg"
dmesg | grep -iE 'edgetpu|janeiro|tachyon' | tail -20 >>"$LOG"

log "done"
tail -n 40 "$LOG"
