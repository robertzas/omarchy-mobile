#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""tpu-kci: send one raw KCI command to janeiro through the driver's ioctl.

The driver's command set is `enum edgetpu_kci_code` in Google's GPL-2.0
`drivers/edgetpu/edgetpu-kci.h`. Its raw send ioctl is `_IOW(0xED, 34, u32)`:
the argument is one word, `code | (variant << 8)`, where variant 0 sends no
data and variant 1 sends the `{u64 address, u32 size, u32 pad}` descriptor in
the following bytes. This tool sends only codes that are read-only for the
firmware, and prints the driver's status; it never maps buffers or creates
groups.

    tools/phone-ssh 'python3 - --code 11 --json' < tools/tpu-kci

Runs on the phone as root, with janeiro loaded. One TPU power-up per boot: if
the device is cold, acquire the wakelock first (`tools/tpu-info --load`) and
treat that boot as spent.
"""

import argparse
import fcntl
import json
import os
import struct
import sys

EDGETPU_IOCTL_BASE = 0xED

# _IOW(0xED, 34, __u32)
KCI_SEND = ((1 << 30) | (4 << 16) | (EDGETPU_IOCTL_BASE << 8) | 34)

# Codes this tool will send: read-only queries the driver itself sends during
# the firmware handshake. Anything that changes device state is refused.
READ_ONLY_CODES = {11: "FIRMWARE_INFO", 12: "GET_USAGE_V1", 8: "GET_DEBUG_DUMP"}


def main():
    ap = argparse.ArgumentParser(
        description="Send one read-only KCI command to janeiro.")
    ap.add_argument("--code", type=int, required=True,
                    help="KCI code to send (11, 12, 8)")
    ap.add_argument("--variant", type=int, default=0,
                    help="ioctl variant: 0 = no data, 1 = dma descriptor")
    ap.add_argument("--device", default="/dev/janeiro")
    ap.add_argument("--dry-run", action="store_true",
                    help="print the request and send nothing")
    ap.add_argument("--json", action="store_true")
    args = ap.parse_args()

    if args.code not in READ_ONLY_CODES:
        sys.exit(f"refusing code {args.code}: this tool sends only "
                 f"{sorted(READ_ONLY_CODES)}")
    word = (args.code & 0xFFFF) | ((args.variant & 0xFF) << 8)
    request = {"code": args.code, "name": READ_ONLY_CODES[args.code],
               "variant": args.variant, "ioctl": hex(KCI_SEND)}
    if args.dry_run:
        print(json.dumps({**request, "sent": False}) if args.json
              else f"{request['name']} code {args.code} variant "
                   f"{args.variant} ioctl {request['ioctl']}: dry run")
        return 0

    try:
        fd = os.open(args.device, os.O_RDWR)
    except OSError as err:
        sys.exit(f"{args.device}: {err.strerror}")
    try:
        fcntl.ioctl(fd, KCI_SEND, bytearray(struct.pack("=I", word)), True)
    except OSError as err:
        out = {**request, "sent": True, "status": "error",
               "errno": err.errno, "error": err.strerror}
        print(json.dumps(out) if args.json
              else f"{request['name']}: ioctl failed: {err.strerror} "
                   f"(errno {err.errno})")
        return 1
    finally:
        os.close(fd)

    out = {**request, "sent": True, "status": "ok"}
    print(json.dumps(out) if args.json
          else f"{request['name']}: driver accepted the command (status 0)")
    return 0


if __name__ == "__main__":
    main()
